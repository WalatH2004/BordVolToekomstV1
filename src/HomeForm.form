<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="HomeForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="36d29" binding="tabbedPane">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="b181f" binding="homePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title="Home"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
          <grid id="d861b" binding="koelkastPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title="Koelkast"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
          <grid id="357c4" binding="productToevoegenPanel" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title="Product toevoegen"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="2c7d6" class="javax.swing.JLabel" binding="barcodeLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Barcode:"/>
                </properties>
              </component>
              <vspacer id="d5f4f">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                </constraints>
              </vspacer>
              <component id="80b14" class="javax.swing.JTextField" binding="barcodeField">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="18def" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Productnaam:"/>
                </properties>
              </component>
              <component id="2e861" class="javax.swing.JTextField" binding="textField1" default-binding="true">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="d404c" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Houdbaar tot:"/>
                </properties>
              </component>
              <component id="d216d" class="javax.swing.JTextField" binding="textField2" default-binding="true">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="3410d" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Aantal:"/>
                </properties>
              </component>
              <component id="e8830" class="javax.swing.JTextField" binding="textField3" default-binding="true">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <grid id="9725e" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="b4f85" class="javax.swing.JButton" binding="scanButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <text value="Scan"/>
                    </properties>
                  </component>
                  <component id="22ee6" class="javax.swing.JButton" binding="opslaanButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <text value="Opslaan"/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
          <grid id="51452" binding="receptenPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title="Recepten"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
          <grid id="4e40d" binding="instellingenPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title="Instellingen"/>
            </constraints>
            <properties>
              <focusable value="true"/>
              <opaque value="true"/>
            </properties>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
